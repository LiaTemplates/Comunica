{
  "name": "communica-template",
  "version": "0.0.3",
  "description": "LiaScript template for Comunica v5 SPARQL queries",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx parcel build",
    "watch": "npx parcel watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "targets": {
    "regular": {
      "source": "src/index.ts",
      "context": "browser",
      "outputFormat": "global",
      "isLibrary": false
    }
  },
  "alias": {
    "chevrotain": "./node_modules/chevrotain/lib/chevrotain.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@comunica/query-sparql": "^5.1.3",
    "@comunica/query-sparql-rdfjs": "^5.1.3",
    "chevrotain": "^11.1.1",
    "n3": "^2.0.1"
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  }
}
