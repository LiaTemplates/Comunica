{
  "name": "comunica-template",
  "version": "0.0.5",
  "description": "LiaScript template for Comunica v5 SPARQL queries",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx parcel build",
    "watch": "npx parcel watch",
    "test": "node --test src/"
  },
  "targets": {
    "regular": {
      "source": "src/index.ts",
      "context": "browser",
      "outputFormat": "global",
      "isLibrary": false
    }
  },
  "alias": {
    "chevrotain": "./node_modules/chevrotain/lib/chevrotain.mjs",
    "lru-cache": "./node_modules/lru-cache/dist/esm/browser/index.min.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@comunica/query-sparql": "^5.4.1",
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "chevrotain": "^11.1.1",
    "jsonld-streaming-parser": "^5.0.1",
    "jsonld-streaming-serializer": "^4.0.0",
    "n3": "^2.0.1",
    "rdfxml-streaming-parser": "^3.2.0",
    "shacl-engine": "^1.1.3",
    "vis-network": "^10.1.4"
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  }
}
